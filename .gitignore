# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
manifest.json
*.key
*.pub
*.cap
testfile.bin
.*
*.mmdb

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# Editor/IDE
# .idea/
# .vscode/

# revika runtime state (persisted node shares, ledger, keys, mock store)
.revika/
# local cache of framework datasets (ATT&CK STIX, D3FEND, NIST 800-53) for tools/check_attack_ids.py
tools/.frameworks/
tools/.attack-stix/
# Python tooling bytecode
__pycache__/
*.pyc
# compiled binaries
revika
revika-node
revika-ctl
revika-daemon
